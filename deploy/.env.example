# Copy to deploy/.env (never commit it) and fill in.
# Generate secrets with: openssl rand -hex 32   (hex only: the DB password goes into a URL)

# Public host name of the server. On a VPS without a domain: <ip-with-dashes>.sslip.io
# Local test of this stack: http://localhost
DG_DOMAIN=http://localhost

POSTGRES_PASSWORD=
DG_JWT_SECRET=
